*.py[cod]
.venv/
venv/

# Laufzeitdaten: Ledger, Bulletin Board, Server-Schluessel
# data* statt data/: Ein Backup-Verzeichnis heisst data.backup.<zeit> und wurde
# von data/ nicht erfasst - es lag nur wegen *.sqlite3 ausserhalb des Repos.
# Ein Abzug mit anderer Endung waere veroeffentlicht worden (EIP-T-041).
# Der Schraegstrich bleibt: data*/ trifft Verzeichnisse, nicht database.py.
data*/
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
